#!/usr/bin/env bash
set -euo pipefail

repo=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
check=$repo/scripts/rgx1gen11-network-policy-check
tmp=$(mktemp -d)
trap 'rtrash -rf "$tmp"' EXIT

fail() {
  printf 'FAIL: %s\n' "$*" >&2
  exit 1
}

cat >"$tmp/good.config" <<'EOF'
CONFIG_SOCK_CGROUP_DATA=y
CONFIG_NFT_SOCKET=m
CONFIG_NETFILTER_XT_MATCH_CGROUP=m
EOF

test -x "$check" || fail "missing rgx1gen11 network-policy config checker"
"$check" "$tmp/good.config" >/dev/null

for key in CONFIG_SOCK_CGROUP_DATA CONFIG_NFT_SOCKET CONFIG_NETFILTER_XT_MATCH_CGROUP; do
  sed "/^${key}=/d" "$tmp/good.config" >"$tmp/bad.config"
  if "$check" "$tmp/bad.config" >/dev/null 2>&1; then
    fail "checker accepted a config without $key"
  fi
done

"$check" "$repo/rgx1gen11.config" >/dev/null \
  || fail "rgx1gen11 overlay lacks the protected-process classifier contract"
"$check" "$repo/rgam5terra.config" >/dev/null \
  || fail "rgam5terra overlay lacks the protected-process classifier contract"
"$check" "$repo/rgSURFLat.config" >/dev/null \
  || fail "rgSURFLat overlay lacks the protected-process classifier contract"
"$check" >/dev/null \
  || fail "default check must accept every profile overlay"

sed '/^CONFIG_NFT_REJECT=/d' "$repo/rglat5340.config" >"$tmp/noreject.config"
if "$check" "$tmp/noreject.config" >/dev/null 2>&1; then
  fail "checker accepted an overlay missing CONFIG_NFT_REJECT"
fi
mkdir -p "$tmp/hw"
sed 's/^# CONFIG_IWLWIFI is not set$/CONFIG_IWLWIFI=m/' "$repo/rgam5terra.config" >"$tmp/hw/rgam5terra.config"
if "$check" "$tmp/hw/rgam5terra.config" >/dev/null 2>&1; then
  fail "checker accepted iwlwifi on rgam5terra"
fi
grep -q 'NetworkManager' "$repo/51-linux-rg-net-rglat5340.conf" \
  || fail "rglat5340 sysctl must name NetworkManager"
if grep -q '^net.ipv4.tcp_notsent_lowat' "$repo/51-linux-rg-net-rgam5terra.conf"; then
  fail "terra sysctl must not carry the laptop lowat"
fi

mkdir -p "$tmp/empty/kernel/net/netfilter"
if "$check" --modules "$tmp/empty" "$tmp/good.config" >/dev/null 2>&1; then
  fail "checker accepted a module tree without nft_socket"
fi
touch "$tmp/empty/kernel/net/netfilter/nft_socket.ko"
"$check" --modules "$tmp/empty" "$tmp/good.config" >/dev/null \
  || fail "checker rejected a module tree that contains nft_socket"

printf 'ok\n'
