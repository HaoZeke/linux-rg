#!/usr/bin/env bash
# Check a kernel .config or profile overlay for CRIU required knobs
# (https://criu.org/Linux_kernel). Usage: linux-rg-criu-check [file ...]
# Default: the three profile overlays in this repo.
set -euo pipefail

repo=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
if (($# == 0)); then
  set -- "$repo/rgx1gen11.config" "$repo/rgam5terra.config" "$repo/rgSURFLat.config"
fi

need=(
  CONFIG_CHECKPOINT_RESTORE=y
  CONFIG_NAMESPACES=y
  CONFIG_UTS_NS=y
  CONFIG_IPC_NS=y
  CONFIG_SYSVIPC=y
  CONFIG_SYSVIPC_SYSCTL=y
  CONFIG_PID_NS=y
  CONFIG_NET_NS=y
  CONFIG_FHANDLE=y
  CONFIG_EVENTFD=y
  CONFIG_EPOLL=y
  CONFIG_KCMP=y
  CONFIG_PROC_CHILDREN=y
  CONFIG_UNIX_DIAG=y
  CONFIG_INET_DIAG=y
  CONFIG_INET_UDP_DIAG=y
  CONFIG_PACKET=y
  CONFIG_PACKET_DIAG=y
  CONFIG_NETLINK_DIAG=y
  CONFIG_NETFILTER_XT_MARK=y
  CONFIG_TUN=y
  CONFIG_INOTIFY_USER=y
  CONFIG_FANOTIFY=y
  CONFIG_MEMCG=y
  CONFIG_CGROUP_DEVICE=y
  CONFIG_MEM_SOFT_DIRTY=y
  CONFIG_USERFAULTFD=y
)

fail=0
for cfg in "$@"; do
  if [[ ! -f $cfg ]]; then
    printf 'FAIL: missing %s\n' "$cfg" >&2
    fail=1
    continue
  fi
  for key in "${need[@]}"; do
    if ! grep -Fqx -- "$key" "$cfg"; then
      printf 'FAIL: %s missing %s\n' "$cfg" "$key" >&2
      fail=1
    fi
  done
done

if ((fail)); then
  exit 1
fi
printf 'ok: %s file(s)\n' "$#"
