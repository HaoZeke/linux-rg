#!/usr/bin/env bash
# Selftest for linux-rg-grokos-tune-check.
set -euo pipefail
repo=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
check=$repo/scripts/linux-rg-grokos-tune-check
fail() { printf 'FAIL: %s\n' "$*" >&2; exit 1; }

"$check" || fail "packaged sysctl must pass"
tmp=$(mktemp)
trap 'rm -f "$tmp"' EXIT
printf 'vm.swappiness = 100\n' >"$tmp"
"$check" "$tmp" && fail "swappiness-only file must fail" || true
echo ok
