#!/usr/bin/env bash
set -euo pipefail

repo=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
audit="$repo/scripts/rgx1gen11-mm-weld-audit"

fail() {
  printf 'FAIL: %s\n' "$*" >&2
  exit 1
}

test -x "$audit" || fail "missing executable MM weld audit"

tmpdir=$(mktemp -d)
trap 'rm -rf "$tmpdir"' EXIT

cp "$repo/0018-cachy-mm-ratios.patch" "$tmpdir/0018.patch"
"$audit" "$tmpdir/0018.patch" >"$tmpdir/good"
rg -Fq 'ok: 0018 prepares the floors on both the MGLRU and classic paths' "$tmpdir/good" \
  || fail "audit should report both reclaim paths"

# Drop the first call site (the lru_gen memcg walk).
awk '/^\+[ \t]*prepare_workingset_protection\(pgdat, sc\);/ && !done { done = 1; next } { print }' \
  "$repo/0018-cachy-mm-ratios.patch" >"$tmpdir/0018.patch"
if "$audit" "$tmpdir/0018.patch" >"$tmpdir/bad" 2>&1; then
  fail "audit should fail when one reclaim path loses the floors"
fi
rg -Fq 'fail: 0018 prepares the floors on 1 reclaim path(s)' "$tmpdir/bad" \
  || fail "audit failure should count the remaining reclaim paths"

cp "$repo/0018-cachy-mm-ratios.patch" "$tmpdir/0018.patch"
sed -i 's/scan_balance = SCAN_ANON;/scan_balance = SCAN_FILE;/' "$tmpdir/0018.patch"
if "$audit" "$tmpdir/0018.patch" >"$tmpdir/bad" 2>&1; then
  fail "audit should fail when clean floors stop forcing anon scans"
fi

printf 'ok\n'
