#!/usr/bin/env bash
set -euo pipefail
repo=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
check=$repo/scripts/linux-rg-grokos-sessiond-check
fail() { printf 'FAIL: %s\n' "$*" >&2; exit 1; }

"$check" "$repo/80-linux-rg-grokos-sessiond.conf" || fail "repo drop-in must pass"
tmp=$(mktemp -d)
trap 'rtrash -rf "$tmp"' EXIT
printf '[Service]\nExecStart=/bin/false\n' >"$tmp/empty.conf"
"$check" "$tmp/empty.conf" && fail "empty unit must fail" || true
printf '[Service]\nManagedOOMMemoryPressure=kill\n' >"$tmp/kill.conf"
"$check" "$tmp/kill.conf" && fail "kill-on-sessiond must fail" || true
cp "$repo/80-linux-rg-grokos-sessiond.conf" "$tmp/removed-accounting.conf"
printf 'CPUAccounting=yes\n' >>"$tmp/removed-accounting.conf"
if "$check" "$tmp/removed-accounting.conf" >/dev/null 2>&1; then
	fail "removed CPUAccounting directive must fail"
fi
echo ok
