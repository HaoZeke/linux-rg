#!/usr/bin/env bash
# Accept LINUX_RG_PROFILE values the PKGBUILD prepare() switch allows.
set -euo pipefail
repo_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
cd "$repo_root"

fail() { printf 'FAIL: %s\n' "$*" >&2; exit 1; }

# Mirror PKGBUILD prepare profile gate (keep in sync with PKGBUILD case arm).
accept_profile() {
  local linux_rg_profile=$1
  case "$linux_rg_profile" in
    rgx1gen11|rgam5terra|rgSURFLat) return 0 ;;
    *) return 1 ;;
  esac
}

for p in rgx1gen11 rgam5terra rgSURFLat; do
  accept_profile "$p" || fail "expected accept $p"
  test -f "$p.config" || fail "missing overlay $p.config"
done
accept_profile nope && fail "nope must be rejected" || true

# Exercise the real PKGBUILD case line via bash extract
tmp=$(mktemp)
trap 'rm -f "$tmp"' EXIT
# Pull the case from PKGBUILD and eval with a function
awk '/local linux_rg_profile=\$\{LINUX_RG_PROFILE/,/echo "Using linux-rg profile/' PKGBUILD > "$tmp" || true
grep -q 'rgSURFLat' PKGBUILD || fail "PKGBUILD missing rgSURFLat allowlist"
grep -q 'rgSURFLat' docs/profiles.org || fail "profiles.org missing rgSURFLat"
grep -q 'Dell Latitude 7430' docs/profiles.org || fail "profiles.org missing Latitude 7430"
test -f docs/rgSURFLat-drivers.org || fail "missing drivers doc"
test -f docs/rgSURFLat-kernel.org || fail "missing kernel doc"
test -f docs/grokos-kernel.org || fail "missing grokos kernel doc"
"$repo_root/scripts/linux-rg-grokos-seat-check-selftest" || fail "grokos seat check"
"$repo_root/scripts/linux-rg-criu-check-selftest" || fail "criu check"
"$repo_root/scripts/linux-rg-grokos-tune-check-selftest" || fail "grokos tune check"
grep -q '50-linux-rg-grokos.conf' PKGBUILD || fail "PKGBUILD missing grokos sysctl"
grep -q 'default auto' asa-router || fail "asa-router missing auto default"
grep -q '0023-asa-workqueue-seat.patch' PKGBUILD || fail "PKGBUILD missing ASA workqueue patch"
grep -q '0024-asa-alg1-vote.patch' PKGBUILD || fail "PKGBUILD missing ASA Algorithm 1 vote patch"
grep -q 'asa_ring_idx' 0024-asa-alg1-vote.patch || fail "0024 missing ring index helper"
grep -q 'p <= theta' 0024-asa-alg1-vote.patch || fail "0024 missing per-sample theta gate"
grep -q '0025-asa-review-fixes.patch' PKGBUILD || fail "PKGBUILD missing ASA review-fix patch"
grep -q 'LOAD_INT' 0025-asa-review-fixes.patch || fail "0025 missing FIXED_1 PSI percent"
grep -q 'asa_store_clamped' 0025-asa-review-fixes.patch || fail "0025 missing clamped stores"
grep -q '0026-asa-seat-sched.patch' PKGBUILD || fail "PKGBUILD missing ASA seat-sched patch"
grep -q 'asa_read_seat_sched' 0026-asa-seat-sched.patch || fail "0026 missing seat sched walk"
grep -q '0027-asa-goal-notify-ring.patch' PKGBUILD || fail "PKGBUILD missing ASA goal-notify patch"
grep -q 'ASA_GOAL_PFX' 0027-asa-goal-notify-ring.patch || fail "0027 missing goal prefix"
grep -q 'cgroup_is_populated' 0027-asa-goal-notify-ring.patch || fail "0027 missing populated goal walk"
grep -q 'sysfs_notify' 0027-asa-goal-notify-ring.patch || fail "0027 missing recommended_scheduler notify"
grep -q 'vote_head = (idx + 1) % window' 0027-asa-goal-notify-ring.patch || fail "0027 missing vote_head wrap"
grep -q 'copy_n' 0027-asa-goal-notify-ring.patch || fail "0027 missing newest-first resize copy"
grep -q '0030-asa-drop-goal-prefix.patch' PKGBUILD || fail "PKGBUILD missing ASA drop-prefix patch"
grep -q 'asa_count_goal_leaves' 0030-asa-drop-goal-prefix.patch || fail "0030 missing goal-walk removal"
grep -q 'grokos-goal-' docs/grokos-kernel.org && fail "grokos-kernel.org still names grokos-goal-" || true
grep -q 'grokos-goal-' 50-linux-rg-grokos.conf && fail "sysctl comment still names grokos-goal-" || true
grep -q '0028-asa-standalone-obj.patch' PKGBUILD || fail "PKGBUILD missing ASA standalone object patch"
grep -q 'obj-$(CONFIG_SCHED_ASA)' 0028-asa-standalone-obj.patch || fail "0028 missing Makefile asa.o"
grep -q 'depends on PSI && SYSFS' 0028-asa-standalone-obj.patch || fail "0028 still depends on SCHED_CLASS_EXT"
grep -q '/sys/kernel/asa' asa-router || fail "asa-router missing /sys/kernel/asa fallback"
grep -q 'CONFIG_SCHED_ASA dropped' scripts/linux-rg-rebase-build || fail "rebase-build missing SCHED_ASA gate"
grep -q 'CONFIG_PROC_CHILDREN=y' scripts/linux-rg-grokos-seat-check || fail "seat-check missing PROC_CHILDREN cancel pin"
grep -q 'cancelAgent' docs/grokos-kernel.org || fail "grokos-kernel.org missing cancelAgent"
grep -q 'farm kconfig:' scripts/linux-rg-rebase-build || fail "rebase-build missing EXT farm print"
grep -q 'CONFIG_SCHED_CLASS_EXT=y' rgx1gen11.config rgam5terra.config rgSURFLat.config || fail "overlay missing SCHED_CLASS_EXT"
grep -q 'seat_cgroup' 0023-asa-workqueue-seat.patch || fail "0023 missing seat_cgroup"
grep -q 'delayed_work' 0023-asa-workqueue-seat.patch || fail "0023 missing delayed_work"
grep -q 'cancel_delayed_work_sync' 0023-asa-workqueue-seat.patch || fail "0023 missing disable cancel"
grep -q 'seat_cgroup' docs/grokos-kernel.org || fail "grokos-kernel.org missing seat_cgroup"
grep -q -- '--seat-cgroup' asa-router || fail "asa-router missing --seat-cgroup"

# Simulate prepare profile switch using same case as PKGBUILD
for linux_rg_profile in rgSURFLat rgx1gen11 rgam5terra; do
  case "$linux_rg_profile" in
    rgx1gen11|rgam5terra|rgSURFLat) ;;
    *) fail "unsupported linux-rg profile: $linux_rg_profile" ;;
  esac
done
linux_rg_profile=nope
if case "$linux_rg_profile" in rgx1gen11|rgam5terra|rgSURFLat) true ;; *) false ;; esac; then
  fail "nope accepted"
fi

# Config overlay must pin Dell + Intel stacks for rgSURFLat
for key in CONFIG_DELL_LAPTOP=m CONFIG_DRM_I915=m CONFIG_IWLWIFI=m CONFIG_SND_SOC_SOF_INTEL_TGL=m; do
  grep -Fqx -- "$key" rgSURFLat.config || fail "rgSURFLat.config missing $key"
done
grep -q THINKPAD_ACPI rgSURFLat.config && fail "rgSURFLat.config should not pin THINKPAD_ACPI" || true

# PKGBUILD source= vs sha256sums/b2sums parity (expanded brace sources, not ${...}).
# Ensures new profile assets cannot land without matching integrity hashes.
python3 - "$repo_root/PKGBUILD" <<'PY' || fail "PKGBUILD source/checksum parity check failed"
import hashlib, re, subprocess, sys
from pathlib import Path

pkgbuild = Path(sys.argv[1])
text = pkgbuild.read_text()
root = pkgbuild.parent

def extract_sums(name: str) -> list[str]:
    start = text.find(f"{name}=(")
    if start < 0:
        raise SystemExit(f"missing {name}")
    m = re.match(rf"{re.escape(name)}=\(((\s*'[^']*')+)\s*\)", text[start:], re.S)
    if not m:
        raise SystemExit(f"cannot parse {name}")
    return re.findall(r"'([^']*)'", m.group(1))

def source_lines() -> list[str]:
    m = re.search(r"^source=\((.*?)^\)", text, re.M | re.S)
    if not m:
        raise SystemExit("missing source=(")
    out = []
    for line in m.group(1).splitlines():
        line = line.split("#")[0].strip()
        if line:
            out.append(line)
    return out

def expand_makepkg_braces(entry: str) -> list[str]:
    holes: list[str] = []

    def protect(m: re.Match[str]) -> str:
        holes.append(m.group(0))
        return f"\x00{len(holes) - 1}\x00"

    protected = re.sub(r"\$\{[^}]+\}", protect, entry)
    if "{" not in protected:
        return [entry]
    m = re.search(r"\{([^{}]+)\}", protected)
    if not m:
        return [entry]
    pre, mid, post = protected[: m.start()], m.group(1), protected[m.end() :]
    out = []
    for alt in mid.split(","):
        s = pre + alt + post
        s = re.sub(r"\x00(\d+)\x00", lambda mm: holes[int(mm.group(1))], s)
        out.append(s)
    return out

expanded: list[str] = []
for e in source_lines():
    expanded.extend(expand_makepkg_braces(e))
sha = extract_sums("sha256sums")
b2 = extract_sums("b2sums")
if not (len(expanded) == len(sha) == len(b2)):
    raise SystemExit(
        f"parity fail: expanded={len(expanded)} sha256sums={len(sha)} b2sums={len(b2)}"
    )

profile_locals = (
    "rgSURFLat.config",
    "rgSURFLat-iwlwifi.conf",
    "rgSURFLat-btusb.conf",
    "rgx1gen11.config",
    "rgam5terra.config",
)
for name in profile_locals:
    if name not in expanded:
        raise SystemExit(f"source= missing {name}")
    idx = expanded.index(name)
    path = root / name
    if not path.is_file():
        raise SystemExit(f"missing file {name}")
    got_sha = hashlib.sha256(path.read_bytes()).hexdigest()
    got_b2 = subprocess.check_output(["b2sum", str(path)], text=True).split()[0]
    if sha[idx] != got_sha:
        raise SystemExit(f"sha256sums[{idx}] mismatch for {name}")
    if b2[idx] != got_b2:
        raise SystemExit(f"b2sums[{idx}] mismatch for {name}")
print(f"source/checksum parity ok ({len(expanded)} entries)")
PY

# Never ship invalid NVIDIA PAT modprobe (610.x open: unknown parameter).
# Comments may mention the name; active options lines must not.
while IFS= read -r f; do
  if grep -E '^[[:space:]]*options[[:space:]].*NVreg_UsePageAttributeTable' "$f" >/dev/null; then
    fail "invalid NVreg_UsePageAttributeTable in $f"
  fi
done < <(find "$repo_root" -maxdepth 1 -name '*.conf' -print)
# Packaged install path on a system with linux-rg must also be clean when present.
if [[ -f /usr/lib/modprobe.d/rgam5terra-nvidia.conf ]]; then
  if grep -E '^[[:space:]]*options[[:space:]].*NVreg_UsePageAttributeTable' \
    /usr/lib/modprobe.d/rgam5terra-nvidia.conf >/dev/null; then
    fail "installed /usr/lib/modprobe.d/rgam5terra-nvidia.conf still sets NVreg_UsePageAttributeTable (rebuild/reinstall linux-rg)"
  fi
fi

printf 'ok\n'
