#!/usr/bin/env bash
# Static audit of the 7.2 ratio-floor carry (0018). The MGLRU dev-tree
# weld (0019) is gone: 7.2 MGLRU reclaim reaches the floors through
# shrink_node() and the lru_gen memcg walk, so both call sites are checked.
set -euo pipefail

ratio_patch=${1:-0018-cachy-mm-ratios.patch}
failures=0

pass() {
  printf 'ok: %s\n' "$1"
}

fail() {
  printf 'fail: %s\n' "$1" >&2
  failures=$((failures + 1))
}

want_pattern() {
  local pattern=$1 description=$2 failure_description=${3:-$2}
  if rg -qU "$pattern" "$ratio_patch"; then
    pass "$description"
  else
    fail "$failure_description"
  fi
}

if [[ ! -r $ratio_patch ]]; then
  fail "not readable: $ratio_patch"
  exit 1
fi

for key in ANON_MIN_RATIO CLEAN_LOW_RATIO CLEAN_MIN_RATIO; do
  want_pattern "config $key\b" "0018 defines $key"
done
for knob in workingset_protection anon_min_ratio clean_low_ratio clean_min_ratio; do
  want_pattern "\.procname\s*=\s*\"$knob\"" "0018 registers vm.$knob"
done
want_pattern 'folio_is_file_lru\(folio\) \? sc->clean_below_min' \
  '0018 keeps folios below the floors in shrink_folio_list'
want_pattern '\(sc->clean_below_low \|\| sc->clean_below_min\) \{\n\+\s*scan_balance = SCAN_ANON;' \
  '0018 forces anon scanning when clean file is under its floors'
want_pattern 'file \? sc->clean_below_min : sc->anon_below_min' \
  '0018 zeroes per-LRU scan targets under the min floors'
want_pattern 'prepare_workingset_protection\(pgdat, sc\)' \
  '0018 prepares node-local ratio state'

calls=$(rg -c '^\+\s*prepare_workingset_protection\(pgdat, sc\);' "$ratio_patch" || true)
if [[ ${calls:-0} -ge 2 ]]; then
  pass '0018 prepares the floors on both the MGLRU and classic paths'
else
  fail "0018 prepares the floors on ${calls:-0} reclaim path(s), want MGLRU and classic"
fi

if (( failures > 0 )); then
  exit 1
fi
