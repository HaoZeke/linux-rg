From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: linux-rg <linux-rg@local>
Date: Thu, 20 Aug 2026 00:00:00 +0000
Subject: [PATCH] sched/asa: build the router without BTF or sched_ext

SCHED_CLASS_EXT depends on DEBUG_INFO_BTF. Farm builds turn BTF off,
olddefconfig then drops EXT and ASA, and asa.c never compiles. Build
asa.o from the Makefile, depend only on PSI+SYSFS, and register under
/sys/kernel/asa when sched_ext is off.

---
--- a/kernel/Kconfig.preempt
+++ b/kernel/Kconfig.preempt
@@ -195,12 +195,14 @@
 
 config SCHED_ASA
 	bool "Adaptive Scheduling Agent router (ASA prototype)"
-	depends on SCHED_CLASS_EXT && PSI
+	depends on PSI && SYSFS
 	default n
 	help
 	  Prototype kernel support for the Mixture-of-Schedulers Adaptive
 	  Scheduling Agent (ASA) from arXiv:2511.11628. Exposes heuristic
 	  workload perception, time-weighted voting, and sched_ext expert
-	  mapping under /sys/kernel/sched_ext/asa/. Userspace loads expert
-	  sched_ext BPF schedulers; the kernel recommends switches via sysfs
-	  uevents.
+	  mapping. Built as its own object so it does not require BTF or
+	  sched_ext. Sysfs lives at /sys/kernel/sched_ext/asa/ when
+	  sched_ext is enabled, otherwise /sys/kernel/asa/. Userspace
+	  loads expert sched_ext BPF schedulers; the kernel recommends
+	  switches via sysfs uevents.

--- a/kernel/sched/asa.c
+++ b/kernel/sched/asa.c
@@ -4,10 +4,12 @@
  *
  * Perception/decision split from arXiv:2511.11628. Sampling runs on a
  * freezable workqueue so PSI and optional seat-cgroup lookup can sleep.
- * Userspace loads expert sched_ext BPF via /sys/kernel/sched_ext/asa/.
+ * Userspace loads expert sched_ext BPF via /sys/kernel/sched_ext/asa/
+ * when sched_ext is on, otherwise /sys/kernel/asa/.
  */
 #include <linux/cgroup.h>
 #include <linux/err.h>
+#include <linux/init.h>
 #include <linux/kobject.h>
 #include <linux/mutex.h>
 #include <linux/psi.h>
@@ -18,6 +20,7 @@
 #include <linux/sysfs.h>
 #include <linux/workqueue.h>
 
+#include "asa.h"
 #include "sched.h"
 
 #define ASA_CLASS_NR		4
@@ -884,7 +887,7 @@
 	.attrs = asa_attrs,
 };
 
-int asa_init(struct kset *scx_kset)
+int asa_init(struct kobject *parent)
 {
 	int i, ret;
 
@@ -908,7 +911,9 @@
 	if (!asa.vote_ring)
 		return -ENOMEM;
 
-	asa_kobj = kobject_create_and_add("asa", &scx_kset->kobj);
+	if (!parent)
+		parent = kernel_kobj;
+	asa_kobj = kobject_create_and_add("asa", parent);
 	if (!asa_kobj) {
 		kfree(asa.vote_ring);
 		return -ENOMEM;
@@ -924,3 +929,11 @@
 	pr_info("sched_asa: workqueue router, optional seat_cgroup PSI\n");
 	return 0;
 }
+
+#ifndef CONFIG_SCHED_CLASS_EXT
+static int __init asa_sysfs_init(void)
+{
+	return asa_init(kernel_kobj);
+}
+late_initcall(asa_sysfs_init);
+#endif

--- a/kernel/sched/asa.h
+++ b/kernel/sched/asa.h
@@ -0,0 +1,9 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef _KERNEL_SCHED_ASA_H
+#define _KERNEL_SCHED_ASA_H
+
+struct kobject;
+
+int asa_init(struct kobject *parent);
+
+#endif

--- a/kernel/sched/build_policy.c
+++ b/kernel/sched/build_policy.c
@@ -61,9 +61,6 @@
 # include "ext_internal.h"
 # include "ext.c"
 # include "ext_idle.c"
-# ifdef CONFIG_SCHED_ASA
-#  include "asa.c"
-# endif
 #endif
 
 #include "syscalls.c"

--- a/kernel/sched/Makefile
+++ b/kernel/sched/Makefile
@@ -41,3 +41,4 @@
 obj-y += build_policy.o
 obj-y += build_utility.o
 obj-$(CONFIG_SCHED_BORE) += bore.o
+obj-$(CONFIG_SCHED_ASA) += asa.o

--- a/kernel/sched/ext.c
+++ b/kernel/sched/ext.c
@@ -4773,11 +4773,9 @@ static void scx_cgroup_exit(struct scx_sched *sch) {}
 static int scx_cgroup_init(struct scx_sched *sch) { return 0; }
 #endif
 
 
-#ifdef CONFIG_SCHED_ASA
-int asa_init(struct kset *scx_kset);
-#endif
+#include "asa.h"
 
 /********************************************************************************
  * Sysfs interface and ops enable/disable.
  */

@@ -10008,7 +10006,7 @@ static int __init scx_init(void)
 		return ret;
 	}
 
 #ifdef CONFIG_SCHED_ASA
-	ret = asa_init(scx_kset);
+	ret = asa_init(&scx_kset->kobj);
 	if (ret) {
 		pr_err("sched_ext: Failed to initialize ASA router (%d)\n", ret);
 		return ret;
