#!/bin/bash
# ASA userspace action module (arXiv:2511.11628 prototype).
# Watches ASA sysfs and loads expert sched_ext schedulers.
set -euo pipefail

if [[ -d /sys/kernel/sched_ext/asa ]]; then
	ASA_SYSFS=/sys/kernel/sched_ext/asa
elif [[ -d /sys/kernel/asa ]]; then
	ASA_SYSFS=/sys/kernel/asa
else
	ASA_SYSFS=/sys/kernel/sched_ext/asa
fi
SCX_LOADER=(scx_loader)

usage() {
	cat <<'EOF'
Usage: asa-router [--enable] [--dry-run] [--mapping FILE] [--seat-cgroup PATH]

  --enable         Write 1 to asa/enabled after starting
  --dry-run        Print recommendations without loading schedulers
  --mapping        Optional mapping file (class=scheduler per line)
  --seat-cgroup    cgroup v2 path for ASA PSI (default auto = sessiond user.slice)

Waits on recommended_scheduler via sysfs poll (sysfs_notify). sample_ms
is milliseconds. Requires: CONFIG_SCHED_ASA; scx_loader for apply.
EOF
}

enable_asa=0
dry_run=0
mapping_file=
seat_cgroup=

while [[ $# -gt 0 ]]; do
	case "$1" in
	--enable) enable_asa=1 ;;
	--dry-run) dry_run=1 ;;
	--mapping) mapping_file=$2; shift ;;
	--seat-cgroup) seat_cgroup=$2; shift ;;
	-h|--help) usage; exit 0 ;;
	*) echo "unknown arg: $1" >&2; usage; exit 1 ;;
	esac
	shift
done

if [[ ! -d $ASA_SYSFS ]]; then
	echo "ASA sysfs missing; boot a CONFIG_SCHED_ASA kernel" >&2
	exit 1
fi

if [[ -z $seat_cgroup && -e $ASA_SYSFS/seat_cgroup ]]; then
	seat_cgroup=auto
fi
if [[ -n $seat_cgroup ]]; then
	if [[ $seat_cgroup == auto ]]; then
		if [[ $(id -u) -eq 0 && -n ${SUDO_UID:-} && -d /sys/fs/cgroup/user.slice/user-${SUDO_UID}.slice ]]; then
			seat_cgroup=/user.slice/user-${SUDO_UID}.slice
		elif [[ $(id -u) -eq 0 ]]; then
			seat_cgroup=/user.slice
		else
			seat_cgroup=/user.slice/user-$(id -u).slice
		fi
	fi
	if [[ ! -e $ASA_SYSFS/seat_cgroup ]]; then
		echo "ASA seat_cgroup sysfs missing; boot a kernel with the workqueue ASA patch" >&2
		exit 1
	fi
	echo "$seat_cgroup" >"$ASA_SYSFS/seat_cgroup"
fi

if [[ -n $mapping_file ]]; then
	while IFS= read -r line || [[ -n $line ]]; do
		[[ $line =~ ^# ]] && continue
		[[ -z $line ]] && continue
		echo "$line" >"$ASA_SYSFS/mapping"
	done <"$mapping_file"
fi

if [[ $enable_asa -eq 1 ]]; then
	echo 1 >"$ASA_SYSFS/enabled"
fi

current=
apply_scheduler() {
	local sched=$1
	[[ $sched == none || -z $sched ]] && return 0
	[[ $sched == "$current" ]] && return 0
	if [[ $dry_run -eq 1 ]]; then
		echo "[dry-run] would load $sched"
		current=$sched
		return 0
	fi
	if ! command -v scx_loader >/dev/null; then
		echo "scx_loader not found; recommendation: $sched" >&2
		return 1
	fi
	echo "ASA: switching sched_ext expert to $sched"
	"${SCX_LOADER[@]}" switch "$sched"
	current=$sched
}

wait_for_recommendation() {
	local path=$ASA_SYSFS/recommended_scheduler
	local ms sleep_s
	if command -v python3 >/dev/null 2>&1; then
		if python3 - "$path" <<'PY'
import os, select, sys

path = sys.argv[1]
try:
    fd = os.open(path, os.O_RDONLY)
except OSError:
    sys.exit(1)
try:
    poller = select.poll()
    poller.register(fd, select.POLLPRI | select.POLLERR)
    os.read(fd, 4096)
    poller.poll()
finally:
    os.close(fd)
PY
		then
			return 0
		fi
	fi
	ms=$(cat "$ASA_SYSFS/sample_ms" 2>/dev/null || echo 1000)
	[[ $ms =~ ^[0-9]+$ ]] || ms=1000
	((ms < 50)) && ms=50
	sleep_s=$(awk -v ms="$ms" 'BEGIN { printf "%.3f", ms / 1000 }')
	sleep "$sleep_s"
}

while :; do
	apply_scheduler "$(cat "$ASA_SYSFS/recommended_scheduler")"
	wait_for_recommendation
done