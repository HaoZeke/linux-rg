From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: linux-rg <linux-rg@local>
Date: Wed, 19 Aug 2026 00:00:00 +0000
Subject: [PATCH] sched/asa: vote with paper Algorithm 1

Gate each sample class by theta, weight with alpha^(W-t), and index the
ring without unsigned underflow. All-zero scores keep the previous class.

---
--- a/kernel/sched/asa.c
+++ b/kernel/sched/asa.c
@@ -69,6 +69,7 @@
 	struct asa_vote_slot	*vote_ring;
 	unsigned int		vote_head;
 	unsigned int		vote_count;
+	u64			vote_score[ASA_CLASS_NR];
 
 	unsigned long		last_switch_jiffies;
 	u64			last_ctxsw;
@@ -183,44 +184,65 @@
 		probs[i] = DIV_ROUND_CLOSEST(scores[i] * 10000U, total);
 }
 
+#define ASA_VOTE_SCALE 10000ULL
+
+/* Newest written slot: sample stores at vote_head % window then increments. */
+static unsigned int asa_ring_idx(unsigned int head, unsigned int age,
+				 unsigned int window)
+{
+	return (head + window - 1 - age) % window;
+}
+
+/*
+ * Time-weighted probability voting (Wang et al., arXiv:2511.11628, Alg. 1).
+ * p'_c = p_c if p_c > theta else 0; A_c += p'_c * alpha^{W-t}; C = argmax A.
+ * probs and theta are in 1/10000 units. decay_pct is (1-alpha)*100.
+ */
 static enum asa_workload_class asa_vote_locked(void)
 {
 	u64 scores[ASA_CLASS_NR] = { 0 };
-	u64 total = 0;
-	unsigned int i, w, window = max(asa.voting_window, 1U);
-	enum asa_workload_class best = ASA_CLASS_MIXED;
+	unsigned int i, c, window, n;
+	enum asa_workload_class best = asa.voted_class;
 	u64 best_score = 0;
+	u32 theta = asa.vote_threshold_pct;
+	u32 alpha = 100 - min(asa.decay_pct, 99U);
 
 	if (!asa.vote_ring || !asa.vote_count)
 		return asa.voted_class;
 
-	for (i = 0; i < asa.vote_count; i++) {
-		unsigned int idx = (asa.vote_head - 1 - i) % window;
-		struct asa_vote_slot *slot = &asa.vote_ring[idx];
-		u64 weight = 100;
-		int c;
+	window = max(asa.voting_window, 1U);
+	n = min(asa.vote_count, window);
 
-		if (asa.decay_pct) {
-			unsigned int keep = 100 - min(asa.decay_pct, 99U);
-			unsigned int age;
+	for (i = 0; i < n; i++) {
+		unsigned int idx = asa_ring_idx(asa.vote_head, i, window);
+		struct asa_vote_slot *slot = &asa.vote_ring[idx];
+		u64 weight = ASA_VOTE_SCALE;
+		unsigned int age;
 
-			for (age = 0; age < i; age++)
-				weight = max(1ULL, weight * keep / 100);
+		for (age = 0; age < i; age++)
+			weight = weight * alpha / 100;
+		if (!weight)
+			weight = 1;
+
+		for (c = 0; c < ASA_CLASS_NR; c++) {
+			u16 p = slot->probs[c];
+
+			if (p <= theta)
+				continue;
+			scores[c] += (u64)p * weight;
 		}
-		for (c = 0; c < ASA_CLASS_NR; c++)
-			scores[c] += (u64)slot->probs[c] * weight;
 	}
 
-	for (w = 0; w < ASA_CLASS_NR; w++) {
-		total += scores[w];
-		if (scores[w] > best_score) {
-			best_score = scores[w];
-			best = w;
+	memcpy(asa.vote_score, scores, sizeof(scores));
+
+	for (c = 0; c < ASA_CLASS_NR; c++) {
+		if (scores[c] > best_score) {
+			best_score = scores[c];
+			best = c;
 		}
 	}
 
-	if (total && asa.vote_threshold_pct &&
-	    (best_score * 10000ULL) / total < asa.vote_threshold_pct)
+	if (!best_score)
 		return asa.voted_class;
 
 	asa.voted_class = best;
@@ -319,13 +341,14 @@
 {
 	u32 rq_avg, csw_per_sec, cpu_psi, io_psi, mem_psi, goal_leaves;
 	char path[ASA_SEAT_PATH_LEN];
-	u64 last_ctxsw, ctxsw;
+	u64 last_ctxsw, ctxsw, vote[ASA_CLASS_NR];
 	unsigned long last_jiffies, now;
 
 	mutex_lock(&asa.lock);
 	strscpy(path, asa.seat_path);
 	last_ctxsw = asa.last_ctxsw;
 	last_jiffies = asa.last_sample_jiffies;
+	memcpy(vote, asa.vote_score, sizeof(vote));
 	mutex_unlock(&asa.lock);
 
 	asa_read_rq_avg(&rq_avg);
@@ -339,10 +362,18 @@
 			  "io_psi_pct=%u\n"
 			  "mem_psi_pct=%u\n"
 			  "seat_cgroup=%s\n"
-			  "goal_leaves=%u\n",
+			  "goal_leaves=%u\n"
+			  "vote_interactive=%llu\n"
+			  "vote_cpu=%llu\n"
+			  "vote_io=%llu\n"
+			  "vote_mixed=%llu\n",
 			  rq_avg, csw_per_sec, cpu_psi, io_psi, mem_psi,
 			  path[0] ? path : "/",
-			  goal_leaves);
+			  goal_leaves,
+			  vote[ASA_CLASS_INTERACTIVE],
+			  vote[ASA_CLASS_CPU],
+			  vote[ASA_CLASS_IO],
+			  vote[ASA_CLASS_MIXED]);
 }
 
 static ssize_t workload_show(struct kobject *kobj, struct kobj_attribute *a,
@@ -591,7 +622,7 @@
 	asa.cooldown_ms = 5000;
 	asa.sample_ms = 1000;
 	asa.voting_window = 8;
-	asa.vote_threshold_pct = 5500;
+	asa.vote_threshold_pct = 2000;
 	asa.decay_pct = 20;
 	asa.voted_class = ASA_CLASS_MIXED;
 	asa.last_ctxsw = nr_context_switches();
