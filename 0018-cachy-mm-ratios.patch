From: linux-rg <linux-rg@local>
Subject: [PATCH] mm: anon and clean file ratio floors on 7.2

Carry vm.anon_min_ratio, vm.clean_low_ratio, vm.clean_min_ratio,
and vm.workingset_protection onto the 7.2 reclaim paths.

---
--- a/mm/vmscan.c
+++ b/mm/vmscan.c
@@ -13,6 +13,7 @@
 #define pr_fmt(fmt) KBUILD_MODNAME ": " fmt
 
 #include <linux/mm.h>
+#include <linux/sysinfo.h>
 #include <linux/sched/mm.h>
 #include <linux/module.h>
 #include <linux/gfp.h>
@@ -146,6 +147,15 @@
 	/* The file folios on the current node are dangerously low */
 	unsigned int file_is_tiny:1;
 
+	/* Anonymous folios on the current node are below vm.anon_min_ratio */
+	unsigned int anon_below_min:1;
+
+	/* Clean file folios on the current node are below vm.clean_low_ratio */
+	unsigned int clean_below_low:1;
+
+	/* Clean file folios on the current node are below vm.clean_min_ratio */
+	unsigned int clean_below_min:1;
+
 	/* Always discard instead of demoting to lower tier memory */
 	unsigned int no_demotion:1;
 
@@ -197,6 +207,10 @@
  * From 0 .. MAX_SWAPPINESS.  Higher means more swappy.
  */
 int vm_swappiness = 60;
+static bool sysctl_workingset_protection __read_mostly = true;
+static u8 sysctl_anon_min_ratio __read_mostly = CONFIG_ANON_MIN_RATIO;
+static u8 sysctl_clean_low_ratio __read_mostly = CONFIG_CLEAN_LOW_RATIO;
+static u8 sysctl_clean_min_ratio __read_mostly = CONFIG_CLEAN_MIN_RATIO;
 
 static int sc_swappiness(struct scan_control *sc, struct mem_cgroup *memcg)
 {
@@ -1109,6 +1123,10 @@
 		if (!sc->may_unmap && folio_mapped(folio))
 			goto keep_locked;
 
+		if (folio_is_file_lru(folio) ? sc->clean_below_min :
+		    (sc->anon_below_min && !sc->clean_below_min))
+			goto keep_locked;
+
 		/*
 		 * The number of dirty pages determines if a node is marked
 		 * reclaim_congested. kswapd will stall and start writing
@@ -2539,6 +2557,11 @@
 		goto out;
 	}
 
+	if (sc->clean_below_low || sc->clean_below_min) {
+		scan_balance = SCAN_ANON;
+		goto out;
+	}
+
 	/*
 	 * If there is enough inactive page cache, we do not reclaim
 	 * anything from the anonymous working right now to make sure
@@ -2597,6 +2620,9 @@
 			BUG();
 		}
 
+		if (file ? sc->clean_below_min : sc->anon_below_min)
+			scan = 0;
+
 		nr[lru] = scan;
 	}
 }
@@ -2617,6 +2643,65 @@
 			  lruvec_memcg(lruvec));
 }
 
+static void prepare_workingset_protection(pg_data_t *pgdat,
+					  struct scan_control *sc)
+{
+	unsigned long anon_min_pages;
+	unsigned long clean_low_pages;
+	unsigned long clean_min_pages;
+	unsigned long node_mem_total;
+	struct sysinfo i;
+
+	sc->anon_below_min = 0;
+	sc->clean_below_low = 0;
+	sc->clean_below_min = 0;
+
+	if (!sysctl_workingset_protection)
+		return;
+
+	if (!sysctl_anon_min_ratio &&
+	    !sysctl_clean_low_ratio &&
+	    !sysctl_clean_min_ratio)
+		return;
+
+#ifdef CONFIG_NUMA
+	si_meminfo_node(&i, pgdat->node_id);
+#else
+	si_meminfo(&i);
+#endif
+	node_mem_total = i.totalram;
+	anon_min_pages = node_mem_total * sysctl_anon_min_ratio / 100;
+	clean_low_pages = node_mem_total * sysctl_clean_low_ratio / 100;
+	clean_min_pages = node_mem_total * sysctl_clean_min_ratio / 100;
+
+	if (sysctl_anon_min_ratio) {
+		unsigned long reclaimable_anon;
+
+		reclaimable_anon =
+			node_page_state(pgdat, NR_ACTIVE_ANON) +
+			node_page_state(pgdat, NR_INACTIVE_ANON) +
+			node_page_state(pgdat, NR_ISOLATED_ANON);
+
+		sc->anon_below_min = reclaimable_anon < anon_min_pages;
+	}
+
+	if (sysctl_clean_low_ratio || sysctl_clean_min_ratio) {
+		unsigned long clean;
+		unsigned long dirty;
+		unsigned long reclaimable_file;
+
+		reclaimable_file =
+			node_page_state(pgdat, NR_ACTIVE_FILE) +
+			node_page_state(pgdat, NR_INACTIVE_FILE) +
+			node_page_state(pgdat, NR_ISOLATED_FILE);
+		dirty = node_page_state(pgdat, NR_FILE_DIRTY);
+		clean = reclaimable_file > dirty ? reclaimable_file - dirty : 0;
+
+		sc->clean_below_low = clean < clean_low_pages;
+		sc->clean_below_min = clean < clean_min_pages;
+	}
+}
+
 #ifdef CONFIG_LRU_GEN
 
 DEFINE_STATIC_KEY_FALSE(lru_switch);
@@ -5000,6 +5085,12 @@
 	struct mem_cgroup *memcg = lruvec_memcg(lruvec);
 	struct pglist_data *pgdat = lruvec_pgdat(lruvec);
 
+	prepare_workingset_protection(pgdat, sc);
+
+	if (sysctl_workingset_protection && sc->clean_below_min &&
+	    !can_reclaim_anon_pages(memcg, pgdat->node_id, sc))
+		return 0;
+
 	/* lru_gen_age_node() called mem_cgroup_calculate_protection() */
 	if (mem_cgroup_below_min(NULL, memcg))
 		return MEMCG_LRU_YOUNG;
@@ -6140,6 +6231,8 @@
 	struct lruvec *target_lruvec;
 	bool reclaimable = false;
 
+	prepare_workingset_protection(pgdat, sc);
+
 	if ((lru_gen_enabled() || lru_gen_switching()) && root_reclaim(sc)) {
 		memset(&sc->nr, 0, sizeof(sc->nr));
 		lru_gen_shrink_node(pgdat, sc);
@@ -7629,6 +7722,40 @@
 		.extra1		= SYSCTL_ZERO,
 		.extra2		= SYSCTL_TWO_HUNDRED,
 	},
+	{
+		.procname	= "workingset_protection",
+		.data		= &sysctl_workingset_protection,
+		.maxlen		= sizeof(sysctl_workingset_protection),
+		.mode		= 0644,
+		.proc_handler	= proc_dobool,
+	},
+	{
+		.procname	= "anon_min_ratio",
+		.data		= &sysctl_anon_min_ratio,
+		.maxlen		= sizeof(sysctl_anon_min_ratio),
+		.mode		= 0644,
+		.proc_handler	= proc_dou8vec_minmax,
+		.extra1		= SYSCTL_ZERO,
+		.extra2		= SYSCTL_ONE_HUNDRED,
+	},
+	{
+		.procname	= "clean_low_ratio",
+		.data		= &sysctl_clean_low_ratio,
+		.maxlen		= sizeof(sysctl_clean_low_ratio),
+		.mode		= 0644,
+		.proc_handler	= proc_dou8vec_minmax,
+		.extra1		= SYSCTL_ZERO,
+		.extra2		= SYSCTL_ONE_HUNDRED,
+	},
+	{
+		.procname	= "clean_min_ratio",
+		.data		= &sysctl_clean_min_ratio,
+		.maxlen		= sizeof(sysctl_clean_min_ratio),
+		.mode		= 0644,
+		.proc_handler	= proc_dou8vec_minmax,
+		.extra1		= SYSCTL_ZERO,
+		.extra2		= SYSCTL_ONE_HUNDRED,
+	},
 #ifdef CONFIG_NUMA
 	{
 		.procname	= "zone_reclaim_mode",
--- a/mm/Kconfig
+++ b/mm/Kconfig
@@ -478,6 +478,33 @@
 config ARCH_WANT_HUGETLB_VMEMMAP_PREINIT
 	bool
 
+config ANON_MIN_RATIO
+	int "Default value for vm.anon_min_ratio"
+	depends on SYSCTL
+	range 0 100
+	default 1
+	help
+	  Default for vm.anon_min_ratio. Anonymous pages below this
+	  percentage of node memory are not reclaimed.
+
+config CLEAN_LOW_RATIO
+	int "Default value for vm.clean_low_ratio"
+	depends on SYSCTL
+	range 0 100
+	default 15
+	help
+	  Default for vm.clean_low_ratio. Clean file pages below this
+	  percentage are avoided until reclaim pressure rises.
+
+config CLEAN_MIN_RATIO
+	int "Default value for vm.clean_min_ratio"
+	depends on SYSCTL
+	range 0 100
+	default 4
+	help
+	  Default for vm.clean_min_ratio. Clean file pages below this
+	  percentage are not reclaimed.
+
 config HAVE_MEMBLOCK_PHYS_MAP
 	bool
 
--- a/Documentation/admin-guide/sysctl/vm.rst
+++ b/Documentation/admin-guide/sysctl/vm.rst
@@ -25,6 +25,10 @@
 Currently, these files are in /proc/sys/vm:
 
 - admin_reserve_kbytes
+- anon_min_ratio
+- clean_low_ratio
+- clean_min_ratio
+- workingset_protection
 - compact_memory
 - compaction_proactiveness
 - compact_unevictable_allowed
