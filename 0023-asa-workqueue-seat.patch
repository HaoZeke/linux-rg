From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: linux-rg <linux-rg@local>
Date: Wed, 19 Aug 2026 00:00:00 +0000
Subject: [PATCH] sched/asa: sample on workqueue and classify from seat PSI

Move ASA sampling off a timer so PSI and cgroup lookup run in process
context. Add seat_cgroup sysfs for optional per-slice PSI, clamp the
vote ring, trim mapping writes, and apply vote_threshold / per-age decay.

---
--- a/kernel/sched/asa.c
+++ b/kernel/sched/asa.c
@@ -2,22 +2,28 @@
 /*
  * Adaptive Scheduling Agent (ASA) prototype for linux-rg.
  *
- * Implements the perception/decision/action split from arXiv:2511.11628 using
- * heuristic workload classification and time-weighted probability voting.
- * Expert sched_ext BPF programs are loaded from userspace; the kernel exports
- * sysfs state under /sys/kernel/sched_ext/asa/.
+ * Perception/decision split from arXiv:2511.11628. Sampling runs on a
+ * freezable workqueue so PSI and optional seat-cgroup lookup can sleep.
+ * Userspace loads expert sched_ext BPF via /sys/kernel/sched_ext/asa/.
  */
-#include <linux/timer.h>
+#include <linux/cgroup.h>
+#include <linux/err.h>
 #include <linux/kobject.h>
 #include <linux/mutex.h>
 #include <linux/psi.h>
 #include <linux/sched/loadavg.h>
+#include <linux/slab.h>
+#include <linux/string.h>
+#include <linux/workqueue.h>
 
 #include "sched.h"
 
 #define ASA_CLASS_NR		4
 #define ASA_NAME_LEN		32
 #define ASA_MAP_LINE_LEN	64
+#define ASA_WINDOW_MAX		64
+#define ASA_SEAT_PATH_LEN	128
+#define ASA_SAMPLE_MIN_MS	50
 
 enum asa_workload_class {
 	ASA_CLASS_INTERACTIVE = 0,
@@ -46,10 +52,11 @@
 };
 
 struct asa_router {
-	struct timer_list	sample_timer;
+	struct delayed_work	sample_work;
 
 	char			schedulers[ASA_CLASS_NR][ASA_NAME_LEN];
 	char			recommended[ASA_NAME_LEN];
+	char			seat_path[ASA_SEAT_PATH_LEN];
 	enum asa_workload_class	voted_class;
 
 	unsigned int		enabled;
@@ -78,11 +85,25 @@
 	return load * 100U / LOAD_AVG_MAX;
 }
 
-static void asa_collect_features(u32 *rq_avg, u32 *csw_per_sec,
-				 u32 *cpu_psi, u32 *io_psi, u32 *mem_psi)
+static void asa_read_psi_group(struct psi_group *psi, u32 *cpu_psi,
+			       u32 *io_psi, u32 *mem_psi)
+{
+	if (!psi) {
+		*cpu_psi = 0;
+		*io_psi = 0;
+		*mem_psi = 0;
+		return;
+	}
+	mutex_lock(&psi->avgs_lock);
+	*cpu_psi = asa_load_pct(psi->avg[PSI_CPU_SOME][0]);
+	*io_psi = asa_load_pct(psi->avg[PSI_IO_SOME][0]);
+	*mem_psi = asa_load_pct(psi->avg[PSI_MEM_SOME][0]);
+	mutex_unlock(&psi->avgs_lock);
+}
+
+static void asa_read_rq_avg(u32 *rq_avg)
 {
 	unsigned int cpu, nr = 0, sum = 0;
-	u64 now, ctxsw, dt_jiffies;
 
 	cpus_read_lock();
 	for_each_online_cpu(cpu) {
@@ -91,24 +112,48 @@
 	}
 	cpus_read_unlock();
 	*rq_avg = nr ? DIV_ROUND_UP(sum * 100, nr) : 0;
+}
+
+static u32 asa_ctxsw_rate(u64 last_ctxsw, unsigned long last_jiffies,
+			  u64 *ctxsw_out, unsigned long *now_out)
+{
+	u64 now = jiffies;
+	u64 ctxsw = nr_context_switches();
+	unsigned long dt_jiffies = max(now - last_jiffies, 1UL);
+
+	*ctxsw_out = ctxsw;
+	*now_out = now;
+	return div64_u64((ctxsw - last_ctxsw) * HZ * 100, dt_jiffies);
+}
 
-	now = jiffies;
-	ctxsw = nr_context_switches();
-	dt_jiffies = max(now - asa.last_sample_jiffies, 1UL);
-	*csw_per_sec = div64_u64((ctxsw - asa.last_ctxsw) * HZ * 100,
-				 dt_jiffies);
-	asa.last_ctxsw = ctxsw;
-	asa.last_sample_jiffies = now;
-
-	mutex_lock(&psi_system.avgs_lock);
-	*cpu_psi = asa_load_pct(psi_system.avg[PSI_CPU_SOME][0]);
-	*io_psi = asa_load_pct(psi_system.avg[PSI_IO_SOME][0]);
-	*mem_psi = asa_load_pct(psi_system.avg[PSI_MEM_SOME][0]);
-	mutex_unlock(&psi_system.avgs_lock);
+static void asa_read_seat_psi(const char *seat_path, u32 *cpu_psi,
+			      u32 *io_psi, u32 *mem_psi, u32 *goal_leaves)
+{
+	struct cgroup *cgrp = NULL;
+	struct psi_group *psi = &psi_system;
+
+	*goal_leaves = 0;
+	if (seat_path && seat_path[0]) {
+		cgrp = cgroup_get_from_path(seat_path);
+		if (IS_ERR(cgrp))
+			cgrp = NULL;
+	}
+	if (cgrp) {
+		struct psi_group *seat_psi = cgroup_psi(cgrp);
+
+		if (seat_psi)
+			psi = seat_psi;
+		if (cgrp->nr_descendants > 0)
+			*goal_leaves = 1;
+	}
+	asa_read_psi_group(psi, cpu_psi, io_psi, mem_psi);
+	if (cgrp)
+		cgroup_put(cgrp);
 }
 
 static void asa_classify(u32 rq_avg, u32 csw_per_sec, u32 cpu_psi,
-			 u32 io_psi, u32 mem_psi, u16 probs[ASA_CLASS_NR])
+			 u32 io_psi, u32 mem_psi, u32 goal_leaves,
+			 u16 probs[ASA_CLASS_NR])
 {
 	u32 scores[ASA_CLASS_NR] = { 0 };
 	u32 total = 0;
@@ -122,6 +167,10 @@
 	if (csw_per_sec > 200 && io_psi < 15)
 		scores[ASA_CLASS_INTERACTIVE] += 60;
 	scores[ASA_CLASS_MIXED] = 25 + (rq_avg / 4) + (cpu_psi / 4) + (io_psi / 4);
+	if (goal_leaves) {
+		scores[ASA_CLASS_MIXED] += 20;
+		scores[ASA_CLASS_CPU] += 15;
+	}
 
 	for (i = 0; i < ASA_CLASS_NR; i++)
 		total += scores[i];
@@ -137,28 +186,43 @@
 static enum asa_workload_class asa_vote_locked(void)
 {
 	u64 scores[ASA_CLASS_NR] = { 0 };
+	u64 total = 0;
 	unsigned int i, w, window = max(asa.voting_window, 1U);
 	enum asa_workload_class best = ASA_CLASS_MIXED;
 	u64 best_score = 0;
 
+	if (!asa.vote_ring || !asa.vote_count)
+		return asa.voted_class;
+
 	for (i = 0; i < asa.vote_count; i++) {
 		unsigned int idx = (asa.vote_head - 1 - i) % window;
 		struct asa_vote_slot *slot = &asa.vote_ring[idx];
-		u64 weight = asa.decay_pct ?
-			max(1ULL, (100ULL - asa.decay_pct) / 10ULL) : 1;
+		u64 weight = 100;
 		int c;
 
+		if (asa.decay_pct) {
+			unsigned int keep = 100 - min(asa.decay_pct, 99U);
+			unsigned int age;
+
+			for (age = 0; age < i; age++)
+				weight = max(1ULL, weight * keep / 100);
+		}
 		for (c = 0; c < ASA_CLASS_NR; c++)
 			scores[c] += (u64)slot->probs[c] * weight;
 	}
 
 	for (w = 0; w < ASA_CLASS_NR; w++) {
+		total += scores[w];
 		if (scores[w] > best_score) {
 			best_score = scores[w];
 			best = w;
 		}
 	}
 
+	if (total && asa.vote_threshold_pct &&
+	    (best_score * 10000ULL) / total < asa.vote_threshold_pct)
+		return asa.voted_class;
+
 	asa.voted_class = best;
 	return best;
 }
@@ -178,7 +242,7 @@
 	changed = force_notify || strcmp(asa.recommended, new_rec);
 	strscpy(asa.recommended, new_rec);
 
-	if (changed && time_after(jiffies,
+	if (changed && asa_kobj && time_after(jiffies,
 	    asa.last_switch_jiffies + msecs_to_jiffies(asa.cooldown_ms))) {
 		asa.last_switch_jiffies = jiffies;
 		kobject_uevent(asa_kobj, KOBJ_CHANGE);
@@ -187,28 +251,47 @@
 
 static void asa_sample(struct asa_router *r)
 {
-	u32 rq_avg, csw_per_sec, cpu_psi, io_psi, mem_psi;
+	u32 rq_avg, csw_per_sec, cpu_psi, io_psi, mem_psi, goal_leaves;
 	u16 probs[ASA_CLASS_NR];
 	struct asa_vote_slot *slot;
-	unsigned int idx;
+	unsigned int idx, window;
+	char path[ASA_SEAT_PATH_LEN];
+	u64 last_ctxsw, ctxsw;
+	unsigned long last_jiffies, now;
 
 	mutex_lock(&r->lock);
+	if (!r->enabled || !r->vote_ring) {
+		mutex_unlock(&r->lock);
+		return;
+	}
+	strscpy(path, r->seat_path);
+	last_ctxsw = r->last_ctxsw;
+	last_jiffies = r->last_sample_jiffies;
+	mutex_unlock(&r->lock);
+
+	asa_read_rq_avg(&rq_avg);
+	csw_per_sec = asa_ctxsw_rate(last_ctxsw, last_jiffies, &ctxsw, &now);
+	asa_read_seat_psi(path, &cpu_psi, &io_psi, &mem_psi, &goal_leaves);
+	asa_classify(rq_avg, csw_per_sec, cpu_psi, io_psi, mem_psi,
+		     goal_leaves, probs);
 
-	if (!r->enabled) {
+	mutex_lock(&r->lock);
+	if (!r->enabled || !r->vote_ring) {
 		mutex_unlock(&r->lock);
 		return;
 	}
 
-	asa_collect_features(&rq_avg, &csw_per_sec, &cpu_psi, &io_psi, &mem_psi);
-	asa_classify(rq_avg, csw_per_sec, cpu_psi, io_psi, mem_psi, probs);
+	r->last_ctxsw = ctxsw;
+	r->last_sample_jiffies = now;
 
-	idx = r->vote_head % max(r->voting_window, 1U);
+	window = max(r->voting_window, 1U);
+	idx = r->vote_head % window;
 	slot = &r->vote_ring[idx];
 	slot->timestamp = jiffies;
 	memcpy(slot->probs, probs, sizeof(probs));
 
 	r->vote_head++;
-	if (r->vote_count < r->voting_window)
+	if (r->vote_count < window)
 		r->vote_count++;
 
 	asa_vote_locked();
@@ -217,42 +300,49 @@
 	mutex_unlock(&r->lock);
 }
 
-static void asa_timer_fn(struct timer_list *t)
+static void asa_work_fn(struct work_struct *work)
 {
-	struct asa_router *r = container_of(t, struct asa_router, sample_timer);
+	struct asa_router *r = container_of(to_delayed_work(work),
+					    struct asa_router, sample_work);
+	unsigned int period;
 
 	asa_sample(r);
-	mod_timer(&r->sample_timer, jiffies + msecs_to_jiffies(r->sample_ms));
+	if (!READ_ONCE(r->enabled))
+		return;
+	period = max(READ_ONCE(r->sample_ms), ASA_SAMPLE_MIN_MS);
+	mod_delayed_work(system_freezable_wq, &r->sample_work,
+			 msecs_to_jiffies(period));
 }
 
