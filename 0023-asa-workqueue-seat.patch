+static ssize_t seat_cgroup_show(struct kobject *kobj, struct kobj_attribute *a,
+				char *buf)
+{
+	return sysfs_emit(buf, "%s\n",
+			  asa.seat_path[0] ? asa.seat_path : "/");
+}
+
+static ssize_t seat_cgroup_store(struct kobject *kobj, struct kobj_attribute *a,
+				 const char *buf, size_t count)
+{
+	char path[ASA_SEAT_PATH_LEN];
+
+	if (count == 0 || count >= sizeof(path))
+		return -EINVAL;
+	memcpy(path, buf, count);
+	path[count] = '\0';
+	strim(path);
+	if (path[0] != '/')
+		return -EINVAL;
+
 	mutex_lock(&asa.lock);
-	asa.enabled = !!val;
-	if (asa.enabled && !timer_pending(&asa.sample_timer))
-		mod_timer(&asa.sample_timer, jiffies + msecs_to_jiffies(asa.sample_ms));
-	else if (!asa.enabled)
-		timer_delete_sync(&asa.sample_timer);
+	if (!strcmp(path, "/"))
+		asa.seat_path[0] = '\0';
+	else
+		strscpy(asa.seat_path, path);
 	mutex_unlock(&asa.lock);
+	return count;
+}
+
+static ssize_t voting_window_show(struct kobject *kobj, struct kobj_attribute *a,
+				  char *buf)
+{
+	return sysfs_emit(buf, "%u\n", asa.voting_window);
+}
+
+static ssize_t voting_window_store(struct kobject *kobj, struct kobj_attribute *a,
+				   const char *buf, size_t count)
+{
+	struct asa_vote_slot *ring;
+	unsigned int val;
+	int ret;
+
+	ret = kstrtouint(buf, 10, &val);
+	if (ret)
+		return ret;
+	if (val < 1 || val > ASA_WINDOW_MAX)
+		return -EINVAL;
 
+	ring = kcalloc(val, sizeof(*ring), GFP_KERNEL);
+	if (!ring)
+		return -ENOMEM;
+
+	mutex_lock(&asa.lock);
+	kfree(asa.vote_ring);
+	asa.vote_ring = ring;
+	asa.voting_window = val;
+	asa.vote_head = 0;
+	asa.vote_count = 0;
+	mutex_unlock(&asa.lock);
 	return count;
 }
 
