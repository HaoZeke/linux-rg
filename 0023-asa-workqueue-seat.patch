 static ssize_t enabled_store(struct kobject *kobj, struct kobj_attribute *a,
@@ -335,14 +421,76 @@
 	if (ret)
 		return ret;
 
+	if (val) {
+		WRITE_ONCE(asa.enabled, 1);
+		mod_delayed_work(system_freezable_wq, &asa.sample_work, 0);
+	} else {
+		WRITE_ONCE(asa.enabled, 0);
+		cancel_delayed_work_sync(&asa.sample_work);
+	}
+
+	return count;
+}
