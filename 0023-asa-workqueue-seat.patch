-		const char *eq;
-
-		memcpy(line, p, chunk);
-		line[chunk] = '\0';
-		p += chunk;
-		len -= chunk;
-
-		eq = strchr(line, '=');
-		if (!eq)
-			continue;
-
-		strscpy(key, line);
-		key[eq - line] = '\0';
-		strscpy(val, eq + 1);
-
-		mutex_lock(&asa.lock);
-		for (i = 0; i < ASA_CLASS_NR; i++) {
-			if (!strcmp(key, asa_class_names[i])) {
-				strscpy(asa.schedulers[i], val);
